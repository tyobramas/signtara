{
  "name": "isyara",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3000",
    "build": "tsc --noEmit && vite build",
    "start": "vite preview --host 127.0.0.1 --port 3000",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "test:e2e": "playwright test",
    "ml:extract": "node ml/preprocessing/extract.mjs",
    "ml:train": "node ml/training/train.mjs",
    "ml:references": "node ml/training/select-references.mjs",
    "ml:manifest": "node scripts/model-manifest.mjs",
    "ml:words:download": "sh ml/words/download.sh",
    "ml:words:index": "node ml/words/index-datasets.mjs",
    "ml:words:extract": "node ml/words/extract.mjs ml/words/out/manifest.json 6",
    "ml:words:featurize": "esbuild ml/words/featurize.ts --bundle --platform=node --format=esm --outfile=ml/words/out/featurize.mjs --log-level=warning && node ml/words/out/featurize.mjs .",
    "ml:words:train": "ml/.venv/bin/python ml/words/train.py",
    "ml:words:fewshot": "esbuild ml/words/fewshot.ts --bundle --platform=node --format=esm --outfile=ml/words/out/fewshot.mjs --log-level=warning && node ml/words/out/fewshot.mjs ."
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.14",
    "idb": "8.0.3",
    "lucide-react": "0.468.0",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/react": "19.0.3",
    "@types/react-dom": "19.0.2",
    "typescript": "5.7.3",
    "vite": "^6.4.5",
    "vitest": "^5.0.5"
  }
}
